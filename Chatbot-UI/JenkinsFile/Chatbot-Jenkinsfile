pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Chatbot-UI') {
                    sh 'npm ci'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('openai-sonarqube') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=openai-chatbot \
                          -Dsonar.projectName="OpenAI Chatbot"
                    '''
                }
            }
        }
    }
}