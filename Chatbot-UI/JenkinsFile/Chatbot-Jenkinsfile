pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Chatbot-UI') {
                    sh 'npm ci'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('openai-sonarqube') {
                    script {
                        def scannerHome = tool 'sonar-scanner'

                        dir('Chatbot-UI') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }
	stage('Quality Gate') {
    	    steps {
        	timeout(time: 5, unit: 'MINUTES') {
            	    waitForQualityGate abortPipeline: true
       	        }
   	    }
	}
	stage('OWASP Dependency-Check') {
	    steps {
		withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
            	    dir('Chatbot-UI') {
                        dependencyCheck(
                            additionalArguments: "--scan . --format XML --format HTML --exclude node_modules/** --exclude .next/** --nvdApiKey ${NVD_API_KEY}",
                            odcInstallation: 'OWASP'
                	)
            	    }
        	}
	    }
	}
	stage('Trivy Filesystem Scan') {
    	    steps {
                dir('Chatbot-UI') {
                    sh '''
                        trivy fs . \
                  	  --scanners vuln,misconfig,secret \
                  	  --skip-dirs reference \
                  	  --exit-code 1 \
                  	  --severity HIGH,CRITICAL
                    '''
        	}
    	    }
	}
	stage('Docker Build') {
    	    steps {
        	dir('Chatbot-UI') {
            	    sh '''
                	docker build \
                    	  -t chatbot-ui:${BUILD_NUMBER} \
                    	  .
            	    '''
        	}
    	    }
	}
	stage('Trivy Image Scan') {
   	    steps {
                sh '''
              	    trivy image \
                      --scanners vuln,misconfig,secret \
                      --severity HIGH,CRITICAL \
                      --ignorefile trivyignore \
                      --exit-code 1 \
                      chatbot-ui:${BUILD_NUMBER}
                '''
      	    }
	}
	stage('Push to ECR') {
    	    steps {
		dir('Chatbot-UI') {
        	    withAWS(credentials: 'jenkins-ecr', region: 'eu-north-1') {
            	    	sh '''
                	    aws ecr get-login-password --region eu-north-1 | \
                	    docker login --username AWS --password-stdin \
                 	    574921529429.dkr.ecr.eu-north-1.amazonaws.com

                	    docker tag \
                    	        chatbot-ui:${BUILD_NUMBER} \
                     	        574921529429.dkr.ecr.eu-north-1.amazonaws.com/openai-chatbot:${BUILD_NUMBER}

                	    docker push \
                                574921529429.dkr.ecr.eu-north-1.amazonaws.com/openai-chatbot:${BUILD_NUMBER}
            	    	'''
        	    }
		}
    	    }
	}
    }
}
